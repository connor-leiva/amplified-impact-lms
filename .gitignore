*.tsbuildinfo
# Stray TS emit next to sources. Nothing in src/ is authored as .js, so anything here is an
# accident (a stray  without --noEmit) and must never be committed.
apps/*/src/**/*.js
# D-225: the one exception, the v3 icon sprite: the package's generated file, byte for byte (lms-v3.test.ts).
!apps/web/src/routes/learn/lms-v3/icons.generated.js
apps/*/src/**/*.js.map
packages/*/src/**/*.js
packages/*/src/**/*.js.map
apps/*/*.config.js
apps/*/*.config.js.map
packages/*/**/*.d.ts
!packages/*/src/**/*.d.ts
.env
.env.*
!.env.example
# .env.fixture is build configuration, not a secret: it is how the compliance suite's
# prototype-identical build is selected, so CI needs it in the clone.
!.env.fixture

# Playwright / compliance output (goldens ARE committed)
compliance/report/
compliance/test-results/
# parity:admin-r2's report, diffs and side-by-sides (D-160): posted in a PR comment, never committed.
compliance/parity/out/
compliance/goldens/**/*-actual.png
compliance/goldens/**/*-diff.png
test-results/
playwright-report/
blob-report/
coverage/

.DS_Store
Thumbs.db
.idea/
.vscode/*
!.vscode/extensions.json

# Python caches from the skills' generator scripts (skills/*/evals/make/, D-052).
__pycache__/
*.pyc

