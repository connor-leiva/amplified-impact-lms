{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    // Module resolution stays "Bundler" (from tsconfig.base.json), matching apps/web and
    // packages/core. The API is bundled by build.mjs, which inlines `@ai/core` TypeScript source,
    // so extensionless relative and workspace specifiers are correct here. NodeNext would demand
    // explicit .js extensions and make `@ai/core` unresolvable from this package.
    "types": ["node", "vitest/globals"],
    // The email templates are React Email components (phase 08 section 8.1), so this package
    // compiles .tsx. "dom" is in `lib` for the same reason: @react-email/render renders to an HTML
    // string and its types reach for DOM element interfaces, though nothing here touches a document.
    "jsx": "react-jsx",
    "lib": ["ES2023", "DOM"],
    "paths": {
      "@ai/core": ["../../packages/core/src/index.ts"],
      "@ai/core/*": ["../../packages/core/src/*"]
    }
  },
  "include": ["src/**/*", "test/**/*"]
}
