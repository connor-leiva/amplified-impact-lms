# Data source: 'http' (production, real API) or 'fixture' (prototype-identical, demo + tests)
VITE_DATA_SOURCE=http
# Demo controls (View As / Timeline / Reset Demo). Only honored when VITE_DATA_SOURCE=fixture.
VITE_DEMO_MODE=false
# The /__states contract sheet. Always on in dev.
VITE_ENABLE_STATES=false
