{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "types": ["vite/client", "vitest/globals", "@testing-library/jest-dom"],
    "allowImportingTsExtensions": true,
    "paths": {
      "@ai/core": ["../../packages/core/src/index.ts"],
      "@ai/core/seed/*": ["../../packages/core/seed/*"],
      "@ai/core/*": ["../../packages/core/src/*"],
      "@brand/ai-motion": ["./src/components/motion/ai-motion.d.ts"]
