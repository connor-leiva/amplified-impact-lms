# Fixture mode: the prototype-identical build. This is what the compliance suite runs against.
VITE_DATA_SOURCE=fixture
VITE_ENABLE_STATES=true
VITE_DEMO_MODE=false
# The learner portal v2 at /learn (D-177): on in the fixture build, so its screens can be tested and
# screenshotted. The http build leaves it unset, which is off.
VITE_LEARNER_V2=true
