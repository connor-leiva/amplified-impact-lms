# Fixture mode: the prototype-identical build. This is what the compliance suite runs against.
VITE_DATA_SOURCE=fixture
VITE_ENABLE_STATES=true
VITE_DEMO_MODE=false
# The learner portal v2 at /learn (D-177, D-182): OFF in this build, so the first portal at / is what the
# parity suite compares with design-reference/ (and its goldens), exactly as production serves it. The
# flag-on twin is `build:fixture:v2` (dist-fixture-v2, port 4174), which `pnpm e2e:learn` runs the /learn
# specs against. The http build leaves it unset, which is off.
VITE_LEARNER_V2=false
