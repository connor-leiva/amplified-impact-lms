{
  "name": "@ai/web",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build && vite build -c vite.ai101.config.ts",
    "build:fixture": "vite build --mode fixture --outDir dist-fixture && vite build -c vite.ai101.config.ts --outDir dist-fixture",
    "preview:fixture": "pnpm build:fixture && vite preview --outDir dist-fixture",
    "build:fixture:v2": "node ../../scripts/with-env.mjs VITE_LEARNER_V2=true vite build --mode fixture --outDir dist-fixture-v2",
    "preview:fixture:v2": "pnpm build:fixture:v2 && vite preview --outDir dist-fixture-v2",
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "@ai/core": "workspace:*",
    "@fontsource/dm-mono": "^5.2.8",
    "@fontsource/hanken-grotesk": "^5.2.8",
    "@tanstack/react-query": "^5.104.1",
    "clsx": "^2.1.1",
    "hls.js": "^1.7.3",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "react-router": "^8.4.0"
  },
  "devDependencies": {
    "@testing-library/dom": "^10.4.1",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.1",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.1",
    "jsdom": "^28.0.0",
    "vite": "^8.3.2",
    "vitest": "^5.0.3"
  }
}
