    "test:watch": "vitest",
    "coverage": "vitest run --coverage"
  },
  "dependencies": {
    "immer": "^11.1.21"
  },
  "devDependencies": {
    "@vitest/coverage-v8": "^5.0.3",
    "vitest": "^5.0.3"
  }
}
