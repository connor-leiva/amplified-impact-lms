# Line endings are LF in the repository and in the working tree, on every platform.
# The goldens JSON fingerprints are written with \n by Node; CRLF conversion on checkout would
# make the CI `goldens` job's `git diff --exit-code` fail spuriously on Windows clones.
* text=auto eol=lf

# Binary: never touch these.
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.ico binary
*.webp binary
*.woff binary
*.woff2 binary
*.ttf binary
*.otf binary
*.pdf binary
*.zip binary
*.mp4 binary

# The prototype is the oracle. Keep it byte-for-byte as committed; it changes only through a
# DECISIONS entry (D-031).
design-reference/** -text -diff
handoff-starter/** -text

# Generated and vendored: keep diffs out of review.
compliance/goldens/** linguist-generated
pnpm-lock.yaml -diff linguist-generated
apps/web/src/styles/tokens.css linguist-generated
apps/web/src/styles/global.css linguist-generated
packages/core/src/icons.ts linguist-generated
# Generated by scripts/email-tokens.mjs from tokens.css. A test asserts the committed file
# is byte-identical to a fresh run, so hand-editing it fails the suite (D-021).
apps/api/src/email/tokens.ts linguist-generated
